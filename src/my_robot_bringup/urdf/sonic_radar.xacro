<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    
    <xacro:property name="radar_radius" value="0.02" />
    <xacro:property name="radar_length" value="0.02" />

    <xacro:macro name="ultrasonic_sensor" params="prefix xyz rpy">
        <link name="${prefix}_ultrasonic_link">
            <visual>
                <geometry><cylinder radius="0.02" length="0.02"/></geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry><cylinder radius="0.02" length="0.02"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.02" h="0.02" xyz="0 0 0" rpy="0 0 0"/>
        </link>

        <joint name="${prefix}_ultrasonic_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_ultrasonic_link"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>

        <gazebo reference="${prefix}_ultrasonic_link">
            <sensor name="${prefix}_ultrasonic" type="ray">
                <pose>0 0 0 0 0 0</pose>
                <visualize>false</visualize>
                <update_rate>20</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.02</min>
                        <max>4.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <plugin name="${prefix}_ultrasonic_controller" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <remapping>~/out:=/${prefix}_ultrasonic/range</remapping>
                    </ros>
                    <output_type>sensor_msgs/Range</output_type>
                    <radiation_type>ultrasound</radiation_type>
                    <frame_name>${prefix}_ultrasonic_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <xacro:ultrasonic_sensor prefix="front" xyz="${(base_length) / 2.0} 0 ${base_height - (radar_length)/2.0- 0.001}" rpy="0 0 0"/>
    <xacro:ultrasonic_sensor prefix="left" xyz="0 ${(base_width) / 2.0} ${base_height - (radar_length)/2.0 - 0.001}" rpy="0 0 ${pi/2}"/>
    <xacro:ultrasonic_sensor prefix="right" xyz="0 ${(- base_width) / 2.0} ${base_height - (radar_length)/2.0 - 0.001}" rpy="0 0 ${-pi/2}"/>

</robot>