<launch>
    <arg name="gui" default="true" />
    <arg name="rviz" default="true" />
    <arg name="start_slam" default="true" />
    <arg name="scan_topic" default="/scan_lidar" />
    <arg name="urdf_args" default="with_depth_cameras:=false" />
    <arg name="spawn_x" default="0.0" />
    <arg name="spawn_y" default="0.0" />
    <arg name="spawn_yaw" default="0.0" />
    <arg name="spawn" default="true" />
    <arg name="spawn_delay" default="8.0" />

    <let name="urdf_path"
         value="$(find-pkg-share my_robot_bringup)/urdf/my_robot.urdf.xacro" />
    <let name="rviz_config_path"
         value="$(find-pkg-share my_robot_bringup)/rviz/urdf_config.rviz" />
    <let name="world_path"
         value="$(find-pkg-share my_robot_bringup)/worlds/test_world.world" />
    <let name="slam_params_path"
         value="$(find-pkg-share my_robot_bringup)/config/slam_params.yaml" />

    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py">
        <arg name="world" value="$(var world_path)" />
        <arg name="gui" value="$(var gui)" />
    </include>

    <timer period="3.0">
        <node pkg="robot_state_publisher" exec="robot_state_publisher">
            <param name="robot_description"
                   value="$(command 'xacro $(var urdf_path) $(var urdf_args)')" />
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

    <timer period="$(var spawn_delay)" if="$(var spawn)">
        <node pkg="gazebo_ros" exec="spawn_entity.py"
              args="-topic robot_description -entity my_robot -x $(var spawn_x) -y $(var spawn_y) -z 0.1 -Y $(var spawn_yaw) -timeout 120">
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

    <!-- SLAM стартует позже спавна, чтобы не терять первые сканы -->
    <timer period="10.0" if="$(var start_slam)">
        <node pkg="slam_toolbox" exec="async_slam_toolbox_node"
              name="slam_toolbox" output="screen">
            <param from="$(var slam_params_path)" />
            <param name="scan_topic" value="$(var scan_topic)" />
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

    <timer period="10.0" if="$(var rviz)">
        <node name="rviz2" exec="rviz2" output="screen"
              args="-d $(var rviz_config_path)">
            <param name="use_sim_time" value="true" />
        </node>
    </timer>
</launch>
